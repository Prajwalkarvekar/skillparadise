PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/skillparadise?retryWrites=true&w=majority
# Comma-separated URLs of your public website and dashboard.
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Admin portal authentication. Use fresh, strong values in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_EMAIL=admin@skillparadise.com
ADMIN_NAME=Skill Paradise Admin
# Never enable this in production; it overwrites the admin password on restart.
RESET_ADMIN_ON_START=false
# Enable Places API (New) and billing in Google Cloud, then add these values.
# Keep them in Backend/.env only; never expose the key in frontend files.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=your-skill-paradise-place-id
